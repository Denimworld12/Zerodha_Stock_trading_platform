//@version=5
// =============================================================================
// QSMC - Smart Money Concepts + Mirror Market
// Chart-side twin of the Python engine in quant/qsmc/.
//
// The Pine and Python implementations follow the SAME definitions on purpose:
//   swing      fractal pivot, `len` bars either side, confirmed `len` bars late
//   BOS        close through the last confirmed swing, WITH the current bias
//   CHoCH      close through it AGAINST the bias  -> bias flips
//   sweep      wick through the swing, close back inside (stop hunt, not break)
//   OB         last opposing candle before the displacement leg that broke
//   FVG        3-bar imbalance: low[0] > high[2] (bull) / high[0] < low[2] (bear)
//   premium/discount   position within the live dealing range, 0.5 = equilibrium
//   mirror     beta-hedged spread vs a correlated instrument; |rho| >= threshold
//
// If you change a rule here, change it in quant/qsmc/features/ too, or the chart
// stops being evidence about the thing you are actually trading.
//
// ALERTS: set the alert message to {{strategy.order.alert_message}} and point the
// webhook at  POST <service>/webhook/tradingview  with header
// X-Signal-Secret. Alerts are RECORDED, never auto-executed.
// =============================================================================
indicator("QSMC · SMC + Mirror Market", overlay = true, max_boxes_count = 200, max_lines_count = 200)

// ---------------------------------------------------------------- inputs ----
grpS      = "Structure"
swingLen  = input.int(3,    "Swing lookback (bars each side)", minval = 1, maxval = 20, group = grpS)
showBOS   = input.bool(true,  "Show BOS / CHoCH",   group = grpS)
showSweep = input.bool(true,  "Show liquidity sweeps", group = grpS)

grpZ      = "Zones"
showOB    = input.bool(true,  "Show order blocks",  group = grpZ)
showFVG   = input.bool(true,  "Show fair value gaps", group = grpZ)
maxAge    = input.int(200,  "Zone max age (bars)",  minval = 10, group = grpZ)
dispATR   = input.float(1.0,"Min displacement (ATR)", minval = 0.1, step = 0.1, group = grpZ)

grpM      = "Mirror market"
mirSym    = input.symbol("BINANCE:ETHUSDT", "Mirror instrument", group = grpM)
corrLen   = input.int(240,  "Correlation window",  minval = 20, group = grpM)
minAbsCorr= input.float(0.5,"Min |correlation| for a live mirror", step = 0.05, group = grpM)
divZ      = input.float(1.8,"Dislocation |z| threshold", step = 0.1, group = grpM)

grpR      = "Risk"
atrLen    = input.int(14,   "ATR length", group = grpR)
stopATR   = input.float(1.0,"Stop (ATR)",   step = 0.1, group = grpR)
tpATR     = input.float(2.0,"Target (ATR)", step = 0.1, group = grpR)

// ------------------------------------------------------------ volatility ----
atr = ta.atr(atrLen)

// --------------------------------------------------------------- swings -----
// ta.pivothigh(len, len) is already confirmed `len` bars after the fact, which
// matches the Python engine's rule that a pivot is only knowable at i + len.
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow (low,  swingLen, swingLen)

var float activeHigh = na   // level being watched for a break (consumed on break)
var float activeLow  = na
var float confHigh   = na   // last confirmed levels, for the dealing range
var float confLow    = na
var int   bias       = 0

if not na(ph)
    activeHigh := ph
    confHigh   := ph
if not na(pl)
    activeLow  := pl
    confLow    := pl

// ------------------------------------------------- sweeps and structure -----
sweptHigh = not na(activeHigh) and high > activeHigh and close <= activeHigh
sweptLow  = not na(activeLow)  and low  < activeLow  and close >= activeLow

brokeHigh = not na(activeHigh) and close > activeHigh
brokeLow  = not na(activeLow)  and close < activeLow

bullBOS   = brokeHigh and bias ==  1
bullCHoCH = brokeHigh and bias <=  0
bearBOS   = brokeLow  and bias == -1
bearCHoCH = brokeLow  and bias >=  0

if brokeHigh
    bias       := 1
    activeHigh := na
if brokeLow
    bias       := -1
    activeLow  := na

// ------------------------------------------------- premium / discount -------
rangeSpan = confHigh - confLow
eqPos     = rangeSpan > 0 ? (close - confLow) / rangeSpan : na
inDiscount = not na(eqPos) and eqPos < 0.5
inPremium  = not na(eqPos) and eqPos > 0.5

// ------------------------------------------------------------- mirror -------
mClose = request.security(mirSym, timeframe.period, close)
rBase  = math.log(close)  - math.log(close[1])
rMir   = math.log(mClose) - math.log(mClose[1])

rho    = ta.correlation(rBase, rMir, corrLen)
beta   = ta.covariance(rBase, rMir, corrLen) / math.max(ta.variance(rMir, corrLen), 1e-12)
cumB   = math.sum(rBase, corrLen)
cumM   = math.sum(rMir,  corrLen)
spread = cumB - beta * cumM
spreadZ = (spread - ta.sma(spread, corrLen)) / math.max(ta.stdev(spread, corrLen), 1e-12)

// Sign-agnostic on purpose: a +0.85 correlated leg mirrors this one via its
// short. What must hold is a stable hedge ratio, not a negative rho.
mirrorLive = not na(rho) and math.abs(rho) >= minAbsCorr
mirrorLong  = mirrorLive and spreadZ <= -divZ   // this leg is cheap vs the hedge
mirrorShort = mirrorLive and spreadZ >=  divZ

// ---------------------------------------------------------- order blocks ----
var box[] bullOBs = array.new_box()
var box[] bearOBs = array.new_box()

f_findOB(bool isBull) =>
    idx = -1
    for i = 1 to 12
        opposing = isBull ? close[i] < open[i] : close[i] > open[i]
        if opposing and idx == -1
            idx := i
    idx

bullShift = bullBOS or bullCHoCH
bearShift = bearBOS or bearCHoCH

legUp = (close - ta.lowest(low, 12))  / math.max(atr, 1e-12)
legDn = (ta.highest(high, 12) - close) / math.max(atr, 1e-12)

if showOB and bullShift and legUp >= dispATR
    i = f_findOB(true)
    if i > 0
        array.push(bullOBs, box.new(bar_index - i, high[i], bar_index + 20, low[i],
             border_color = color.new(color.teal, 40), bgcolor = color.new(color.teal, 88)))
if showOB and bearShift and legDn >= dispATR
    i = f_findOB(false)
    if i > 0
        array.push(bearOBs, box.new(bar_index - i, high[i], bar_index + 20, low[i],
             border_color = color.new(color.red, 40),  bgcolor = color.new(color.red, 88)))

// Mitigation: a demand zone dies when price CLOSES below it, supply when above.
f_prune(box[] arr, bool isBull) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            b = array.get(arr, i)
            dead = (isBull ? close < box.get_bottom(b) : close > box.get_top(b)) or
                   (bar_index - box.get_left(b) > maxAge)
            if dead
                box.delete(b)
                array.remove(arr, i)
            else
                box.set_right(b, bar_index + 5)
f_prune(bullOBs, true)
f_prune(bearOBs, false)

// ------------------------------------------------------- fair value gaps ----
bullFVG = low > high[2]
bearFVG = high < low[2]
if showFVG and bullFVG
    box.new(bar_index - 2, low, bar_index + 12, high[2],
         border_color = color.new(color.blue, 60), bgcolor = color.new(color.blue, 92))
if showFVG and bearFVG
    box.new(bar_index - 2, high, bar_index + 12, low[2],
         border_color = color.new(color.orange, 60), bgcolor = color.new(color.orange, 92))

// ------------------------------------------------------------- signals ------
// Mandatory: structure shift our way AND the correct half of the range.
// Scored: sweep, POI, mirror agreement. Mirrors primary_signal() in build.py.
atOBBull = array.size(bullOBs) > 0
atOBBear = array.size(bearOBs) > 0

longScore  = (sweptLow  ? 1 : 0) + (atOBBull or bullFVG ? 1 : 0) + (mirrorLong  ? 1 : 0)
shortScore = (sweptHigh ? 1 : 0) + (atOBBear or bearFVG ? 1 : 0) + (mirrorShort ? 1 : 0)

longSig  = bullShift and inDiscount and longScore  >= 2
shortSig = bearShift and inPremium  and shortScore >= 2

entryP  = close
longSL  = entryP - stopATR * atr
longTP  = entryP + tpATR   * atr
shortSL = entryP + stopATR * atr
shortTP = entryP - tpATR   * atr

// ---------------------------------------------------------------- plots -----
plotshape(showBOS and bullCHoCH, "Bull CHoCH", shape.triangleup,   location.belowbar, color.new(color.teal, 0),   size = size.tiny, text = "CHoCH")
plotshape(showBOS and bearCHoCH, "Bear CHoCH", shape.triangledown, location.abovebar, color.new(color.red, 0),    size = size.tiny, text = "CHoCH")
plotshape(showBOS and bullBOS,   "Bull BOS",   shape.circle,       location.belowbar, color.new(color.teal, 40),  size = size.tiny)
plotshape(showBOS and bearBOS,   "Bear BOS",   shape.circle,       location.abovebar, color.new(color.red, 40),   size = size.tiny)
plotshape(showSweep and sweptLow,  "Sweep low",  shape.xcross, location.belowbar, color.new(color.yellow, 0), size = size.tiny)
plotshape(showSweep and sweptHigh, "Sweep high", shape.xcross, location.abovebar, color.new(color.yellow, 0), size = size.tiny)
plotshape(longSig,  "LONG",  shape.labelup,   location.belowbar, color.new(color.green, 0), size = size.small, text = "LONG",  textcolor = color.white)
plotshape(shortSig, "SHORT", shape.labeldown, location.abovebar, color.new(color.maroon, 0), size = size.small, text = "SHORT", textcolor = color.white)

eqLine = plot(rangeSpan > 0 ? (confHigh + confLow) / 2 : na, "Equilibrium", color.new(color.gray, 50), style = plot.style_linebr)

// ------------------------------------------------------- info table ---------
var table t = table.new(position.top_right, 2, 6, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "QSMC",        bgcolor = color.new(color.gray, 80), text_size = size.small)
    table.cell(t, 1, 0, timeframe.period, bgcolor = color.new(color.gray, 80), text_size = size.small)
    table.cell(t, 0, 1, "Bias",        text_size = size.small)
    table.cell(t, 1, 1, bias == 1 ? "Bullish" : bias == -1 ? "Bearish" : "Flat",
               text_color = bias == 1 ? color.teal : bias == -1 ? color.red : color.gray, text_size = size.small)
    table.cell(t, 0, 2, "Range pos",   text_size = size.small)
    table.cell(t, 1, 2, na(eqPos) ? "n/a" : str.tostring(eqPos * 100, "#.0") + "% " + (inPremium ? "PREM" : "DISC"), text_size = size.small)
    table.cell(t, 0, 3, "Mirror rho",  text_size = size.small)
    table.cell(t, 1, 3, na(rho) ? "n/a" : str.tostring(rho, "#.00") + (mirrorLive ? " live" : " off"), text_size = size.small)
    table.cell(t, 0, 4, "Spread z",    text_size = size.small)
    table.cell(t, 1, 4, na(spreadZ) ? "n/a" : str.tostring(spreadZ, "#.00"), text_size = size.small)
    table.cell(t, 0, 5, "ATR",         text_size = size.small)
    table.cell(t, 1, 5, str.tostring(atr, format.mintick), text_size = size.small)

// ---------------------------------------------------------------- alerts ----
// Matches the TVAlert pydantic model in qsmc/service/api.py.
f_json(string side, float sl, float tp) =>
    '{"symbol":"' + syminfo.ticker + '","side":"' + side +
    '","price":'     + str.tostring(entryP, format.mintick) +
    ',"stop":'       + str.tostring(sl,     format.mintick) +
    ',"target":'     + str.tostring(tp,     format.mintick) +
    ',"timeframe":"' + timeframe.period +
    '","strategy":"qsmc_pine","comment":"bias=' + str.tostring(bias) +
    ' eq=' + (na(eqPos) ? "na" : str.tostring(eqPos, "#.00")) +
    ' rho=' + (na(rho) ? "na" : str.tostring(rho, "#.00")) + '"}'

alertcondition(longSig,  "QSMC Long",  "QSMC long setup")
alertcondition(shortSig, "QSMC Short", "QSMC short setup")
if longSig
    alert(f_json("buy",  longSL,  longTP),  alert.freq_once_per_bar_close)
if shortSig
    alert(f_json("sell", shortSL, shortTP), alert.freq_once_per_bar_close)
