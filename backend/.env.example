# Copy to .env and fill in. NEVER commit .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# ?replicaSet=rs0 is NOT optional. MongoDB refuses multi-document transactions
# on a standalone server, and an order writes to three collections at once.
MONGO_URL=mongodb://localhost:27017/tradingmitra?replicaSet=rs0
PORT=3002
DEFAULT_CURRENCY=INR

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Local email+password is the active provider. REQUIRED in production - the
# server refuses to start without it rather than signing tokens with a
# predictable key.
#   generate:  openssl rand -base64 48
JWT_SECRET=

ACCESS_TOKEN_TTL=900        # 15 minutes
REFRESH_TOKEN_TTL=2592000   # 30 days
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
PAPER_OPENING_BALANCE=100000

# Auth0 - OPTIONAL, and purely additive. Setting these makes Auth0 tokens
# accepted ALONGSIDE password logins; nobody is signed out and no data moves,
# because every record keys off our own user id, never the provider's.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Skips authentication entirely and runs every request as dev@localhost.
# Refused when NODE_ENV=production. Leave false now that real auth works.
AUTH_DEV_BYPASS=false

# ---------------------------------------------------------------------------
# Quant signal service
# ---------------------------------------------------------------------------
SIGNAL_SERVICE_URL=http://localhost:8000
SIGNAL_WEBHOOK_SECRET=change-me

# ---------------------------------------------------------------------------
# Brokers — free tiers. Leave blank until phase 2.
# ---------------------------------------------------------------------------
# OANDA practice: the only free source of REAL FX that runs natively on Linux.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Binance spot testnet: free keys at testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
